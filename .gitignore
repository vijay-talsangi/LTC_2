# ───────────────────────────────────────────
#  LTCC Campus Portal — .gitignore
# ───────────────────────────────────────────

# ── Environment & Secrets ────────────────────
.env
.env.*
!.env.example

# ── Dependencies ─────────────────────────────
node_modules/
.pnp
.pnp.js
frontend/node_modules/
backend/node_modules/
# ── Bun ──────────────────────────────────────
bun.lockb
.bun/

# ── Build Output ──────────────────────────────
dist/
build/
out/
.vite/
*.tsbuildinfo

# ── Uploads (temp files) ──────────────────────
backend/uploads/

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS Files ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
.cache/
.temp/
*.local
