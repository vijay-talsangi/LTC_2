# ───────────────────────────────────────────────────────────
#  LTCC Campus Portal — Backend Environment Variables
#  Copy this file to .env and fill in your actual values.
#  DO NOT commit .env — only .env.example is safe to commit.
# ───────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Neon PostgreSQL ───────────────────────────────────────────
# Get this from https://neon.tech → your project → Connection Details
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# ── JWT ───────────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Admin Seed (used by db:init script) ───────────────────────
ADMIN_EMAIL=admin@ltcc.edu
ADMIN_PASSWORD=Admin@123

# ── Frontend URL (for CORS) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AWS SES — Email (configure when ready) ───────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SES_FROM_EMAIL=noreply@yourdomain.com
